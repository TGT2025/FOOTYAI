# FOOTBALL MIN BETS ENFORCER - ADAPTED FROM MIN TRADES ENFORCER
# =========================================================================================

class FootballMinBetsEnforcer:
    """🎯 ENFORCE 71% WIN RATE & 17 DAILY BETS - ADAPTED FROM TRADING"""
    
    def __init__(
        self,
        system: "FootballAlphaChaserMonolith",
        min_bets_backtest: int = 5,
        min_bets_target: int = 17,
        max_strategy_regen_attempts: Optional[int] = 8,
    ):
        self.system = system
        self.min_bets_backtest = min_bets_backtest
        self.min_bets_target = min_bets_target
        self.max_strategy_regen_attempts = max_strategy_regen_attempts

    def enforce_betting_strategy(self, plan: Dict[str, Any], project_dir: str) -> bool:
        """🎯 ENFORCE STRATEGY VIABILITY"""
        enforcer_logger = logging.getLogger("Football.ENFORCER")
        enforcer_logger.info("🎯 PHASE_START: Strategy viability enforcement")

        attempt = 0
        while True:
            attempt += 1
            max_tries = self.max_strategy_regen_attempts
            if max_tries is not None and attempt > max_tries:
                logger.error("❌ Strategy failed viability after maximum regeneration attempts")
                return False

            enforcer_logger.info(f"🎯 ENFORCEMENT_ATTEMPT: {attempt}")

            # Test strategy
            backtest = self.system.run_mini_backtest(project_dir)
            bets_count = backtest.get("bets", 0)
            if bets_count < self.min_bets_backtest:
                enforcer_logger.warning(f"🎯 BETS_FAIL: {bets_count} < {self.min_bets_backtest}")
                self._regenerate_strategy(
                    plan, project_dir,
                    failure_reason=f"Mini-backtest only {bets_count} bets",
                    attempt=attempt
                )
                continue

            short_perf = self.system.run_short_paper_betting(project_dir, cycles=15)
            bets_count = short_perf.get("total_bets", 0)
            if bets_count < self.min_bets_target:
                enforcer_logger.warning(f"🎯 BETS_FAIL: {bets_count} < {self.min_bets_target}")
                self._regenerate_strategy(
                    plan, project_dir,
                    failure_reason=f"Short paper only {bets_count} bets",
                    attempt=attempt
                )
                continue

            enforcer_logger.info(f"🎯 STRATEGY_VIABLE: {bets_count} bets")
            return True

    def _regenerate_strategy(self, plan: Dict[str, Any], project_dir: str, failure_reason: str, attempt: int):
        """🔄 REGENERATE STRATEGY"""
        enforcer_logger = logging.getLogger("Football.ENFORCER")
        enforcer_logger.info(f"🔄 REGENERATING_STRATEGY: attempt {attempt} - {failure_reason}")

        loosen_factor = min(0.5 + attempt * 0.05, 0.95)
        current_mode = self.system.performance_metrics.get("current_mode", "exploit")
        alpha_temp = 0.5 if current_mode == "explore" else 0.25

        sys_prompt = (
            "You are a SENIOR FOOTBALL BETTING QUANT fixing a NON-BETTING strategy.\n"
            "Produce ONLY the Python file football_strategy.py (no markdown fences, no commentary).\n"
            "HARD CONTRACT REQUIREMENTS:\n"
            "- File MUST define:\n"
            "    class FootballBettingStrategy:\n"
            "        def generate_bets(self, football_data: Dict[str, Any]) -> List[Dict]:\n"
            "            ...\n"
            "- generate_bets MUST return a non-empty list of bet dicts on typical football data:\n"
            "    {\n"
            "      \"fixture_id\": str,\n"
            "      \"bet_type\": \"home_win\" or \"away_win\" or \"draw\" or \"over_2.5\" or \"btts\",\n"
            "      \"confidence\": float,\n"
            "      \"stake\": float,\n"
            "      \"prediction\": str\n"
            "    }\n"
            "- You MAY additionally define:\n"
            "    - BaseFootballStrategy\n"
            "    - build_strategy_universe(config: Dict[str, Any]) -> List[BaseFootballStrategy]\n"
            "  for multi-strategy research, BUT NOT at the expense of FootballBettingStrategy.\n"
            "- DO NOT replace this file with generic utility functions only.\n"
            "- DO NOT remove or rename FootballBettingStrategy.\n"
            "CRITICAL REQUIREMENTS:\n"
            "- On typical football data, every league should produce at least 3-10 bets\n"
            "- If no high-confidence conditions trigger, emit at least one low-confidence bet per league\n"
            "- DO NOT return empty lists for normal football data\n"
            "- Ensure multi-league coverage across 8+ leagues\n"
            f"CURRENT MODE: {current_mode.upper()} - " +
            ("focus on NEW strategy structures and diversification" if current_mode == "explore"
             else "optimize existing strategy parameters and risk tuning") + "\n"
            "Analysis: Team form, injuries, H2H, motivation, odds value, home/away performance.\n"
            "BET if ≥2 permissive: Good form, key players available, H2H advantage, motivation high, value odds.\n"
            "AVOID if ≥1–2 negative: Poor form, key injuries, H2H disadvantage, low motivation, poor odds.\n"
            "Return [{'fixture_id': str, 'bet_type': str, 'confidence': float, 'stake': float, 'prediction': str}].\n"
            "Include helpers: _analyze_form, _check_injuries, _evaluate_h2h, _assess_motivation.\n"
            "Ensure code is immediately syntactically valid."
        )

        user_prompt = f"""
FAILURE_REASON: {failure_reason}
ATTEMPT: {attempt}
LOOSEN_FACTOR: {loosen_factor:.2f}
CONSTRAINTS:
- Avoid overly strict gating; generate bets on typical football data.
- Keep code readable; no giant nested if-chains.
Provide FULL football_strategy.py now:
""".strip()

        try:
            raw_code = self.system.call_agent("deepseek-coder", sys_prompt, user_prompt, temperature=alpha_temp)
            clean_code = self.system._clean_code(raw_code)
            ok, err = self.system.syntax_guard.validate_python_syntax(clean_code, "football_strategy.py")
            if not ok:
                enforcer_logger.error(f"❌ REGENERATED_STRATEGY_INVALID: {err}")
                return
            
            with open(os.path.join(project_dir, "football_strategy.py"), "w", encoding="utf-8") as f:
                f.write(clean_code)
            self.system.generated_files["football_strategy.py"] = clean_code
            enforcer_logger.info("✅ STRATEGY_REGENERATED")

        except Exception as e:
            enforcer_logger.error(f"❌ STRATEGY_REGENERATION_EXCEPTION: {e}")

