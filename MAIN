# =========================================================================================
# SYNTAX GUARD - FROM TRADING MONOLITH
# =========================================================================================

class SyntaxGuard:
    def validate_python_syntax(self, code: str, filename: str):
        import ast
        try:
            ast.parse(code)
            return True, ""
        except Exception as e:
            return False, f"{filename} syntax error: {e}"

# =========================================================================================
# FOOTBALL DATA ENGINE - ENHANCED
# =========================================================================================

class FootballDataEngine:
    """🏈 ENHANCED Football Data Engine - Real API Integration"""
    
    def __init__(self, api_key: str):
        self.api_key = api_key
        self.base_url = "https://v3.football.api-sports.io"
        self.headers = {
            'x-rapidapi-key': api_key,
            'x-rapidapi-host': 'v3.football.api-sports.io'
        }
        
        self.elite_leagues = {
            39: "Premier League", 140: "La Liga", 135: "Serie A", 78: "Bundesliga",
            61: "Ligue 1", 88: "Eredivisie", 94: "Primeira Liga", 203: "Super Lig",
            144: "Champions League", 45: "FA Cup", 48: "World Cup Qualifiers"
        }

    def get_live_fixtures(self) -> List[Dict]:
        """Get live fixtures with enhanced data"""
        try:
            response = requests.get(f"{self.base_url}/fixtures", headers=self.headers, 
                                  params={'live': 'all'}, timeout=30)
            if response.status_code == 200:
                data = response.json()
                return self._process_fixtures(data.get('response', []))
        except Exception as e:
            logger.error(f"Live fixtures failed: {e}")
        return []

    def get_historical_matches(self, league_id: int, season: int = 2024) -> List[Dict]:
        """Get historical match data for strategy development"""
        try:
            response = requests.get(f"{self.base_url}/fixtures", headers=self.headers,
                                  params={'league': league_id, 'season': season, 'status': 'FT'}, timeout=30)
            if response.status_code == 200:
                data = response.json()
                return self._process_fixtures(data.get('response', []))
        except Exception as e:
            logger.error(f"Historical data failed for league {league_id}: {e}")
        return []

    def get_team_stats(self, team_id: int, league_id: int, season: int = 2024) -> Dict:
        """Get detailed team statistics"""
        try:
            response = requests.get(f"{self.base_url}/teams/statistics", headers=self.headers,
                                  params={'team': team_id, 'league': league_id, 'season': season}, timeout=20)
            if response.status_code == 200:
                return response.json().get('response', {})
        except Exception as e:
            logger.error(f"Team stats failed for {team_id}: {e}")
        return {}

    def get_h2h_stats(self, team1: int, team2: int) -> List[Dict]:
        """Get head-to-head historical data"""
        try:
            response = requests.get(f"{self.base_url}/fixtures/headtohead", headers=self.headers,
                                  params={'h2h': f"{team1}-{team2}"}, timeout=20)
            if response.status_code == 200:
                data = response.json()
                return data.get('response', [])
        except Exception as e:
            logger.error(f"H2H stats failed for {team1} vs {team2}: {e}")
        return []

    def get_odds(self, fixture_id: int) -> Dict:
        """Get betting odds from multiple bookmakers"""
        try:
            response = requests.get(f"{self.base_url}/odds", headers=self.headers,
                                  params={'fixture': fixture_id}, timeout=20)
            if response.status_code == 200:
                data = response.json()
                return self._process_odds(data.get('response', []))
        except Exception as e:
            logger.error(f"Odds failed for fixture {fixture_id}: {e}")
        return {}

    def _process_fixtures(self, fixtures: List[Dict]) -> List[Dict]:
        """Process raw fixture data into structured format"""
        processed = []
        for fixture in fixtures:
            try:
                fixture_data = fixture.get('fixture', {})
                teams_data = fixture.get('teams', {})
                goals_data = fixture.get('goals', {})
                league_data = fixture.get('league', {})
                
                processed_fixture = {
                    'fixture_id': fixture_data.get('id'),
                    'timestamp': fixture_data.get('date'),
                    'status': fixture_data.get('status', {}).get('short'),
                    'home_team': teams_data.get('home', {}).get('name'),
                    'away_team': teams_data.get('away', {}).get('name'),
                    'home_team_id': teams_data.get('home', {}).get('id'),
                    'away_team_id': teams_data.get('away', {}).get('id'),
                    'home_goals': goals_data.get('home'),
                    'away_goals': goals_data.get('away'),
                    'total_goals': (goals_data.get('home', 0) or 0) + (goals_data.get('away', 0) or 0),
                    'btts': (goals_data.get('home', 0) or 0) > 0 and (goals_data.get('away', 0) or 0) > 0,
                    'league_id': league_data.get('id'),
                    'league_name': league_data.get('name'),
                    'season': league_data.get('season'),
                    'timestamp_processed': datetime.now().isoformat()
                }
                processed.append(processed_fixture)
            except Exception as e:
                logger.error(f"Error processing fixture: {e}")
        return processed

    def _process_odds(self, odds_data: List[Dict]) -> Dict:
        """Process odds from multiple bookmakers"""
        best_odds = {}
        for bookmaker in odds_data:
            try:
                bookie_name = bookmaker.get('bookmaker', {}).get('name')
                for bet in bookmaker.get('bets', []):
                    if bet.get('name') in ['Match Winner', 'Both Teams Score', 'Over/Under']:
                        for outcome in bet.get('values', []):
                            bet_type = f"{bet['name']}_{outcome['value']}"
                            odds = float(outcome['odds'])
                            if bet_type not in best_odds or odds > best_odds[bet_type]:
                                best_odds[bet_type] = odds
            except Exception as e:
                logger.error(f"Error processing odds: {e}")
        return best_odds

