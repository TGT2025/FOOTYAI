class AgentPerformanceTracker:
    """📊 Track and score individual agent performance"""
    
    def __init__(self):
        self.agent_history = {}
        self.agent_weights = {
            "form_analyzer": 0.7,
            "injury_intelligence": 0.8, 
            "h2h_specialist": 0.6,
            "odds_value_hunter": 0.9
        }
        
    def record_prediction(self, agent_name: str, prediction: Any, actual_result: Any, fixture_data: Dict):
        """Record agent prediction for later validation"""
        if agent_name not in self.agent_history:
            self.agent_history[agent_name] = []
            
        self.agent_history[agent_name].append({
            'prediction': prediction,
            'actual': actual_result,
            'timestamp': datetime.now(),
            'fixture_data': fixture_data,
            'correct': prediction == actual_result
        })
    
    def get_agent_accuracy(self, agent_name: str, lookback_days: int = 30) -> float:
        """Calculate agent accuracy over recent period"""
        if agent_name not in self.agent_history:
            return 0.5  # Default accuracy
            
        cutoff_time = datetime.now() - timedelta(days=lookback_days)
        recent_predictions = [
            p for p in self.agent_history[agent_name] 
            if p['timestamp'] > cutoff_time
        ]
        
        if not recent_predictions:
            return 0.5
            
        correct = sum(1 for p in recent_predictions if p['correct'])
        return correct / len(recent_predictions)
    
    def update_weights_based_on_performance(self):
        """Dynamically adjust agent weights based on performance"""
        for agent_name in self.agent_weights.keys():
            accuracy = self.get_agent_accuracy(agent_name)
            # Exponential moving average update
            new_weight = (self.agent_weights[agent_name] * 0.8) + (accuracy * 0.2)
            self.agent_weights[agent_name] = max(0.1, min(1.0, new_weight))

class AgentFusionEngine:
    """🎯 Intelligent agent signal fusion"""
    
    def __init__(self, performance_tracker: AgentPerformanceTracker):
        self.tracker = performance_tracker
        self.fusion_threshold = 0.65
        
    def fuse_agent_predictions(self, agent_predictions: Dict[str, Any], fixture_data: Dict) -> Dict:
        """Fuse multiple agent predictions using weighted consensus"""
        weighted_predictions = []
        total_weight = 0
        
        for agent_name, prediction in agent_predictions.items():
            weight = self.tracker.agent_weights.get(agent_name, 0.5)
            
            if hasattr(prediction, 'get'):
                confidence = prediction.get('confidence', 0.5)
                prediction_value = prediction.get('prediction')
            else:
                confidence = 0.5
                prediction_value = prediction
                
            # Apply agent-specific weight to confidence
            weighted_confidence = confidence * weight
            weighted_predictions.append({
                'agent': agent_name,
                'prediction': prediction_value,
                'weighted_confidence': weighted_confidence,
                'weight': weight
            })
            total_weight += weight
            
        if not weighted_predictions:
            return {'consensus_confidence': 0, 'recommendation': 'NO_BET'}
            
        # Calculate consensus
        avg_confidence = sum(p['weighted_confidence'] for p in weighted_predictions) / total_weight
        consensus = avg_confidence > self.fusion_threshold
        
        return {
            'consensus_confidence': avg_confidence,
            'recommendation': 'BET' if consensus else 'NO_BET',
            'weighted_predictions': weighted_predictions,
            'fusion_threshold': self.fusion_threshold
        }

class AgentValidationSystem:
    """🔍 Validate and improve individual agents"""
    
    def __init__(self, system: "FootballAlphaChaserMonolith"):
        self.system = system
        self.min_accuracy_threshold = 0.6
        
    def validate_all_agents(self, project_dir: str) -> Dict[str, float]:
        """Test each agent's predictive accuracy"""
        agent_scores = {}
        
        for agent_file in ["form_analyzer_agent.py", "injury_intelligence_agent.py", 
                          "h2h_specialist_agent.py", "odds_value_hunter_agent.py"]:
            accuracy = self._test_agent_accuracy(project_dir, agent_file)
            agent_scores[agent_file.replace('_agent.py', '')] = accuracy
            
        return agent_scores
    
    def _test_agent_accuracy(self, project_dir: str, agent_file: str) -> float:
        """Test individual agent accuracy with historical data"""
        try:
            # Load agent module
            agent_module = self._dynamic_load_agent(project_dir, agent_file)
            if not agent_module:
                return 0.5
                
            # Get historical matches for testing
            test_matches = self._get_historical_test_matches()
            correct_predictions = 0
            total_predictions = 0
            
            for match in test_matches[:20]:  # Test on 20 matches
                try:
                    # Get agent prediction
                    prediction = agent_module.analyze(match)
                    actual_result = self._get_actual_match_result(match)
                    
                    if prediction and actual_result:
                        if self._prediction_correct(prediction, actual_result):
                            correct_predictions += 1
                        total_predictions += 1
                except Exception as e:
                    continue
                    
            return correct_predictions / max(1, total_predictions)
            
        except Exception as e:
            logger.error(f"Agent validation failed for {agent_file}: {e}")
            return 0.5
            
    def _dynamic_load_agent(self, project_dir: str, agent_file: str):
        """Dynamically load agent module"""
        try:
            sys.path.insert(0, project_dir)
            agent_path = os.path.join(project_dir, agent_file)
            
            if not os.path.exists(agent_path):
                return None
                
            spec = importlib.util.spec_from_file_location(agent_file.replace('.py', ''), agent_path)
            module = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(module)
            return module
        except Exception as e:
            logger.error(f"Failed to load agent {agent_file}: {e}")
            return None

